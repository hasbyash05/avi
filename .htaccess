# Ensure correct MIME types for SEO files
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Ensure sitemap.xml and robots.txt are accessible
<Files "sitemap.xml">
  Require all granted
</Files>

<Files "robots.txt">
  Require all granted
</Files>

# Security: Block access to sensitive files
<Files "admin.php">
  # Only allow from specific IPs if needed
</Files>

<Files "data.json">
  Require all granted
</Files>

<Files ".cpanel.yml">
  Require all denied
</Files>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml text/css application/javascript
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
